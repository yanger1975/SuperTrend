# 忽略環境變數與私密金鑰檔案
.env
*.env
*.key
*.pem
config.env
secret.txt

# 忽略特定資料夾與 Python 快取
spec/
.ipynb_checkpoints/
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
temp/

# 忽略日誌與資料庫檔案
*.log
*.db

# 忽略 data 目錄及所有子目錄下的 Markdown 報告
data/**/*.md
data/*.md

# 忽略靜態網頁建置目錄（由 CI 部署至 GitHub Pages）
public/


